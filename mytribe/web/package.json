{
  "name": "mytribe-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "preinstall": "node ../../scripts/lib/refuse-member-install.js",
    "dev": "vite",
    "dev:record": "VITE_ISSUE_RECORDER=1 vite",
    "prebuild": "npm --prefix ../../packages/issue-recorder run build:bookmarklet && mkdir -p public && cp ../../packages/issue-recorder/dist/__recorder.js public/__recorder.js && node scripts/copy-share-fonts.mjs",
    "build": "tsc --noEmit && tsc -p tsconfig.sw.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:cy": "npm run e2e:cy:tsc && firebase emulators:exec --project auntieos-ttpc --only auth,firestore --config ../e2e.firebase.json \"npm run e2e:cy:run\"",
    "e2e:cy:tsc": "tsc -p cypress",
    "e2e:cy:run": "start-server-and-test e2e:cy:server http://127.0.0.1:5173 \"cypress run\"",
    "e2e:cy:open": "npm run e2e:cy:tsc && firebase emulators:exec --project auntieos-ttpc --only auth,firestore --config ../e2e.firebase.json \"start-server-and-test e2e:cy:server http://127.0.0.1:5173 'cypress open --e2e --browser chrome'\"",
    "e2e:cy:server": "VITE_E2E_EMULATOR=127.0.0.1 vite --port 5173 --strictPort --host 127.0.0.1",
    "e2e:real": "bash scripts/e2e-real/run.sh",
    "e2e:real:run": "start-server-and-test e2e:real:server http://127.0.0.1:5173 \"cypress run --config-file cypress.real.config.ts\"",
    "e2e:real:server": "VITE_E2E_EMULATOR=127.0.0.1 VITE_E2E_PROJECT_ID=$E2E_PROJECT_ID VITE_E2E_FUNCTIONS_PORT=$E2E_FUNCTIONS_PORT vite --port 5173 --strictPort --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@sentry/react": "^11.9.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tribetails/geo": "*",
    "@tribetails/issue-recorder": "*",
    "firebase": "^12.19.0",
    "mapbox-gl": "^3.33.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cypress": "^16.2.0",
    "jsdom": "^30.1.3",
    "start-server-and-test": "^3.0.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
