{
  "name": "mytribe-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:record": "VITE_ISSUE_RECORDER=1 vite",
    "prebuild": "npm --prefix ../../packages/issue-recorder run build:bookmarklet && mkdir -p public && cp ../../packages/issue-recorder/dist/__recorder.js public/__recorder.js",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@sentry/react": "^10.70.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "@tiptap/core": "^3.30.0",
    "@tiptap/extension-link": "^3.30.0",
    "@tiptap/extension-underline": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "@tribetails/geo": "*",
    "firebase": "^12.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@tribetails/issue-recorder": "*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
