rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

 // ═══════════════════════════════════════════════════════════════════════════
 // SHARED PROJECT: auntieos-ttpc
 // AuntieOS (staff, Android + Web) and MyTribe (kinfolk portal) share ONE
 // Firebase project, so this file governs both products.
 //
 // THIS FILE IS THE SOURCE OF TRUTH. Owner ruling 2026-07-15.
 // Deploy rules ONLY from this tree:  firebase deploy --only firestore
 //
 // AuntieOS/web/firestore.rules is a symlink to this file, so the mirror
 // follows automatically. The symlink ensures the AuntieOS emulator and the
 // rules-mirror test (web/functions/test/rules-mirror.test.js) verify rules
 // stay in sync, and the AuntieOS admin runs against the current rules.

 // ── AuntieOS staff helpers ───────────────────────────────────────────────
 //
 // TWO STAFF ROLES SINCE #944 (operator ruling 2026-09-22). "admin" is the
 // business owner; "Auntie" is a caretaker, a contractor or employee who must
 // see household information to do the job and must NOT see money.
 // Spec: docs/superpowers/specs/2026-09-22-admin-auntie-access-design.md.
 //
 // `isAuntie()` USED TO LIVE HERE AND MEANT THE OWNER. It is deleted rather
 // than renamed in place, because after the ruling the word names the OTHER
 // role, and a rule reading `isAuntie()` while granting owner power is how the
 // next person reads this file backwards. Deleting the name is also what forced
 // all 116 call sites to be decided one at a time instead of blanket-renamed.
 //
 // isOwner: the owner. The `admin` custom claim, unchanged, so the operator's
 // existing account keeps every grant it has today with no backfill and no
 // lockout window. That backward compatibility is the whole reason the claim
 // was split this way rather than by adding a field beside a shared
 // `admin: true` that both roles would carry.
 //
 // The `!hasAuntieRole()` conjunct is the fail-safe: an account minted with
 // BOTH claims degrades to the caretaker boundary instead of keeping the
 // owner's. `grant-staff-role.mjs` refuses to create such an account; this is
 // what happens if one is created some other way.
    function isOwner() {
      return request.auth != null
             && request.auth.token.admin == true
             && !hasAuntieRole();
    }

 // `'staffRole' in request.auth.token` RATHER THAN A BARE
 // `request.auth.token.staffRole == 'auntie'`, and the difference is not
 // stylistic: in Firestore rules, reading a key a token does not carry is an
 // ERROR, not a null, and an error inside a condition DENIES the request.
 //
 // Written the bare way first, this took down 47 of the 270 existing rules
 // tests with "Property staffRole is undefined on object", because no token in
 // the project carries the new claim yet. That is exactly the deploy-day
 // lockout this whole change is supposed to avoid: the operator's own token has
 // no `staffRole`, so every owner grant in the file would have evaluated to an
 // error and refused. Same trap, and the same fix, as
 // `kinfolkLocationSharingOn()` further down, which reaches for
 // `.data.get(key, default)` for the identical reason.
    function hasAuntieRole() {
      return 'staffRole' in request.auth.token
             && request.auth.token.staffRole == 'auntie';
    }

 // isCaretaker: an Auntie. Carries `staffRole: 'auntie'` and NO `admin` claim,
 // which is what makes every rule and every callable that was never taught
 // about this role REFUSE her rather than silently hand her owner power. Every
 // grant an Auntie holds in this file is therefore a line someone wrote on
 // purpose.
 //
 // Note what this does NOT match: a token carrying some future
 // `staffRole: 'bookkeeper'` is neither owner nor caretaker, and is refused
 // everywhere until somebody writes its rules.
    function isCaretaker() {
      return request.auth != null && hasAuntieRole();
    }

 // isStaff: either staff role. Use for anything the ruling puts on both sides
 // of the line - household and kin records, visits, KinTales, home access,
 // media, the household conversation, the Auntie's own schedule.
    function isStaff() { return isOwner() || isCaretaker(); }

 // isKinfolk: set by setKinfolkClaim Cloud Function when MyTribe user is linked.
 // Claim shape: { role: 'kinfolk', kinfolkId: '<auntieos kinfolk doc id>' }
    function isKinfolk() {
      return request.auth != null && request.auth.token.role == 'kinfolk'
             && request.auth.token.kinfolkId != null;
    }

 // ── MyTribe helpers ───────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }

    function activeMember(fid) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    function memberDoc(fid) {
      return get(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid)).data;
    }

    function isPrimary(fid) {
      return activeMember(fid) && memberDoc(fid).role == 'PRIMARY';
    }

    function hasPerm(fid, p) {
      return isPrimary(fid) || (activeMember(fid) && memberDoc(fid).permissions[p] == true);
    }

    function invoiceKeys() {
      return ['payment', 'invoiceStatus', 'paymentStatus', 'amountMinor', 'currency', 'invoiceId'];
    }

    function restrictedSitterKeys() {
      return ['assignedTo', 'assignedSitterId', 'sitterRate', 'sitterPayout'];
    }

    function diffOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function affects(keys) {
      return request.resource.data.keys().hasAny(keys);
    }

    function invoiceFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(invoiceKeys());
    }

    function sitterFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(restrictedSitterKeys());
    }

    function ownsClientRecord(uid) { return signedIn() && request.auth.uid == uid; }

 // isOperator() lived here and did an exists() on /operators/{uid}. Removed
 // 2026-07-23: nothing in the tree reads, writes, seeds or tests an `operators`
 // collection - the MyTribe operators routing path was deleted long ago (see
 // ISSUES.md #3) and the archived schema table marks the collection
 // "not used by MyTribe anymore". The one document that survives in prod
 // belongs to the owner account, which carries admin:true, so isAuntie()
 // already covers it.
 //
 // It was not free to leave in. The two rules that called it - families/{fid}
 // and families/{fid}/members/{uid} read - evaluate left to right, so an ADMIN
 // reading a family burned activeMember() (an exists + a get) and then this
 // exists() before ever reaching isAuntie(): three billed document accesses per
 // request against the hard per-request budget of 10, spent on a branch that
 // could only ever decide for a uid isAuntie() would have admitted anyway.

 // ── Test-admin sandbox helpers (Stage 0I) ─────────────────────────────────
 // A test admin is a real Firebase Auth user that does NOT get admin:true.
 // Instead it carries a custom claim `testTribeId: "<test kinfolk doc id>"`.
 // Its access is HARD-restricted by these rules to that ONE kinfolk + its
 // related records (keyed by kinfolkId == testTribeId). Live data is
 // unreachable: every scoped rule below ORs in a test-admin branch that only
 // matches when resource.data.kinfolkId == testScope() (or the kinfolk doc id
 // == testScope()). Normal admin (isAuntie) is entirely unaffected.
 // See AuntieOS/docs/2026-06-05-stage-0I-test-admin-sandbox.md.
    function isTestAdmin() {
      return request.auth != null
        && request.auth.token.testTribeId is string
        && request.auth.token.testTribeId.size() > 0;
    }

    function testScope() {
      return request.auth.token.testTribeId;
    }

 // Read+write a scoped doc only when the test admin's tribe owns it. Used by
 // collections keyed on a `kinfolkId` field (kin, invoices, sessions, ...).
    function testOwnsExisting() {
      return isTestAdmin() && resource.data.kinfolkId == testScope();
    }

 // On create the doc does not yet exist as `resource`; gate on the incoming
 // payload's kinfolkId instead. The test admin can only stamp its own tribe.
    function testOwnsIncoming() {
      return isTestAdmin() && request.resource.data.kinfolkId == testScope();
    }

 // ── SOTU - public read ────────────────────────────────────────────────────
    match /meta/stateOfTheUnion {
      allow read: if true;
      allow write: if isOwner();
    }

 // ── Shared catalogs - readable by any signed-in user, written by callables ──
 //
 // Write is CLOSED to every client (punchlist B4, 2026-08-01). It was
 // `isAuntie()`, and under it the two Kotlin trees edited and HARD-DELETED
 // clinics with a direct `.set()` / `.delete()`: no validation, no dedupe check
 // against the name rule `submitVetClinic` enforces on create, and no audit
 // entry. This is a catalog shared with the kinfolk portal, and a household
 // stores the clinic's phone number denormalized beside `vetClinicId`, so a
 // direct edit could neither reach those households nor be traced afterwards.
 //
 // All three writes now have an admin-SDK callable, which bypasses these rules:
 //   create   submitVetClinic   (portal + admin picker, deduped)
 //   update   updateVetClinic   (validated, audited, fans out to households)
 //   retire   archiveVetClinic  (archive, never delete: a hard delete strands
 //                               every household's vetClinicId)
 // Closing the rule is what makes those the ONLY paths, rather than the polite
 // ones. Read stays open to any signed-in user: the pickers and the admin
 // manager both need the live listener, and the admin needs to see the
 // `verified: false` pending submissions the callable withholds.
    match /vet_clinics/{clinicId} {
      allow read: if signedIn();
      allow write: if false;
    }

 // AuntieOS Android's own scheduling pipeline. Operator-only, and deliberately
 // a separate data path from `kin_care_sessions`: the android Schedule grid
 // reads this collection and the web grid reads sessions. Direct client
 // read+write by the operator app (BookingRepository), so unlike most
 // collections here it is NOT callable-mediated and does need a real rule.
 //
 // There was no rule at all, and this file has no catch-all, so every android
 // booking create and every booking list read was permission-denied. It read as
 // a broken feature rather than an error because BookingRepository wraps the
 // calls in runCatching and logs the failure.
    match /enhanced_bookings/{bookingId} {
      allow read, write: if isOwner();
    }

 // Business contact details (name/email/phone) are surfaced to kinfolks via the
 // getBusinessContact callable, which projects exactly four fields and
 // documents "Operational fields ... are NOT exposed here, admin-only".
 //
 // This read was `signedIn()`, which handed the WHOLE doc to every signed-in
 // kinfolk and made that projection cosmetic: serviceRates, businessHours,
 // calendarSyncId, travelBufferMinutes, the GPS/tracking settings and the
 // mytribePortal config all live on this one document, so a kinfolk could read
 // Auntie's pricing and her calendar id straight from the client SDK. No client
 // ever needed it: the MyTribe portal's only direct Firestore reads are
 // conversations/{kinfolkId}/messages and kin_care_sessions/{id}/breadcrumbs -
 // everything else, business contact included, goes through a callable.
 //
 // isTestAdmin() stays because the Stage-0I sandbox DOES read this directly:
 // AuntieOS Android HomeViewModel.load() fans out getBusinessSettings on Home,
 // and dropping that branch would put a false permission banner on the sandbox
 // Home screen (pinned by testAdminSandbox.test.ts).
 // ISSUE #519: `business_settings` is written directly by the clients — there is
 // no callable in front of it — so these rules are the ONLY server-side check
 // anything gets. Until now the write was a bare role gate, which meant an
 // operator-facing configuration document that five Cloud Functions read
 // (`resolveBusinessOpen` for the phone line, quote expiry, visit-date
 // formatting, notification tokens, the booking busy-conflict guard) could take
 // any shape at all from a buggy client.
 //
 // CHECKED ONLY WHEN PRESENT. Three surfaces write this document three
 // different ways: the React admin sends a per-section partial patch, Android
 // sends an arbitrary changed-field subset, and the desktop console sends a
 // changed-field subset too. Requiring a key would break all three; each rule
 // below therefore reads "if this key is in the write, it has to be sane", and
 // says nothing about a key the write does not name.
 //
 // TYPE AND RANGE, NOT POLICY. The bounds bracket a real answer generously.
 // The point is to refuse a shape no reader can act on — a `timeZone` written as
 // a number, a negative retention period, a `travelBufferMinutes` of 10^9 — not
 // to encode what a business may choose. The clients validate the same values
 // where the operator can see it happening; this is the floor under them.
    function bsHas(field) {
      return request.resource.data.keys().hasAny([field]);
    }
    function bsBool(field) {
      return !bsHas(field) || request.resource.data[field] is bool;
    }
    function bsString(field) {
      return !bsHas(field) || request.resource.data[field] is string;
    }
    function bsInt(field, lo, hi) {
      return !bsHas(field)
             || (request.resource.data[field] is int
                 && request.resource.data[field] >= lo
                 && request.resource.data[field] <= hi);
    }
    function bsList(field, maxLen) {
      return !bsHas(field)
             || (request.resource.data[field] is list && request.resource.data[field].size() <= maxLen);
    }
    function validBusinessSettings() {
      return bsString('timeZone')
             && bsString('defaultBookingMode')
             && bsString('defaultCalendarView')
             && bsString('trackingAccuracy')
             && bsBool('allowTimeBlockBooking')
             && bsBool('allowSpecificTimeBooking')
             && bsBool('enableConflictDetection')
             && bsBool('enableAutoReminder24h')
             && bsBool('enableGPSTrackingForAllVisits')
             && bsBool('enablePhotoLocationTagging')
             && bsBool('requireArrivalDepartureVerification')
             && bsBool('autoStartTrackingOnVisitStart')
             && bsBool('allowClientLocationSharing')
             && bsInt('defaultTimeBlockDurationHours', 1, 24)
             && bsInt('travelBufferMinutes', 0, 480)
             && bsInt('saveRoutesForDays', 1, 3650)
             && bsInt('defaultEtaMinutes', 1, 1440)
             && bsInt('draftRetentionDays', 1, 3650)
 // #582: how close to the household counts as arrived. The bounds match
 // ARRIVAL_RADIUS_MIN/MAX_METERS in `functions/src/lib/arrivalVerification.ts`
 // and the three admin editors. The floor is 10 m because a radius tighter than
 // a consumer GPS fix's own error bar refuses everybody, and an operator who
 // wants no check has the switch next to it; the ceiling is 5 km because a
 // radius larger than that is not a check.
             && bsInt('arrivalRadiusMeters', 10, 5000)
             && bsList('timeBlocks', 12)
             && bsList('etaMinuteOptions', 12)
             && bsList('draftRetentionOptions', 12);
    }
    match /business_settings/{docId} {
      allow read: if isOwner() || isTestAdmin();
      allow write: if isOwner() && validBusinessSettings();
    }

 // Coverage Package Builder config (the admin's visit menu + coverage rules).
 // Operator-global, edited only from the AuntieOS admin. Same posture as
 // business_settings: the sandbox test admin may READ it (so the applet loads
 // without a false permission banner) but only a real Auntie may WRITE.
    match /coverage_package_config/{docId} {
      allow read: if isOwner() || isTestAdmin();
      allow write: if isOwner();
    }

 // Task 7.2, Google Calendar over OAuth. DENIED TO EVERY CLIENT, INCLUDING AN
 // AUNTIE, which is stricter than business_settings next door and deliberately
 // so: `integrations_config/googleCalendar` holds a REFRESH TOKEN. That is a
 // standing credential, and whoever holds it can create, edit and delete events
 // on the operator's real calendar until the grant is revoked, so handing it to
 // a client is not leaking data about the calendar, it is handing over the
 // calendar. WRITE is denied for the same weight of reason: a client able to
 // write this doc could point the connection at a token it owns, and the next
 // push would put our households' visits on a calendar someone else controls.
 // Nothing is lost by the denial, because no client needs the document: the
 // admin-gated `getGoogleCalendarConnection` callable returns a projection with
 // the token stripped, and the Admin SDK inside the functions bypasses rules.
 // The collection already had a second server-only occupant before this rule
 // existed, `integrations_config/email` (the smtp2go webhook shared secret, read
 // by `admin/engagementWebhooks.ts`). It was covered by default-deny; writing the
 // rule down makes the posture explicit rather than accidental, and both
 // documents want exactly the same answer.
    match /integrations_config/{docId}          { allow read, write: if false; }
 // One-time OAuth `state` nonces. Denied for the same reason: a caller who could
 // read these could take a pending nonce and complete someone else's connect
 // flow against their own Google account.
    match /google_oauth_states/{nonce}          { allow read, write: if false; }

 // ── AuntieOS flat collections ─────────────────────────────────────────────
 // Kinfolk profile - the AuntieOS canonical household record. A kinfolk writes a
 // short allowlist of their own contact fields; a kinfolk does NOT read the doc.
    function emergencyContactKeys() {
      return ['emergencyContacts', 'emergencyContactName', 'emergencyContactPhone', 'emergencyContactRelation'];
    }

    function onlyAllowedKinfolkFields() {
      // #829: the three flat emergencyContact* keys left this list. Emergency
      // Contacts are written only by the saveEmergencyContacts callable.
      let allowed = ['preferredContactMethod', 'bestTimeToContact', 'secondaryPhone', 'secondaryEmail'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

 // READ IS STAFF-ONLY, and the asymmetry with WRITE below is deliberate.
 // `kinfolk/{id}` carries `internalNotes`, the field the admin UI labels
 // "Anything that doesn't belong on the dossier yet" and renders to staff as an
 // Auntie note callout. Firestore rules cannot mask a field: a read returns the
 // whole document or nothing, so the only way to keep staff notes off a
 // household's screen is to withhold the document. Until this rule was written,
 // the `isKinfolk()` branch here handed every note written about a household to
 // that household.
 //
 // NOTHING IS LOST BY THE DENIAL, because no portal surface reads this
 // collection directly. The web portal touches Firestore in exactly two places
 // (`kin_care_sessions/{id}/breadcrumbs` and `conversations/{id}/messages`), and
 // the KMP portal's entire Firestore facade is `FirestoreClient.listDocuments`
 // plus `breadcrumbsStream`, neither of which is ever called for `kinfolk`.
 // What the portal needs out of the record arrives through callables running on
 // the Admin SDK, which does not evaluate rules, and each of those projects
 // rather than forwarding the document: `getMyHome` takes firstName + lastName
 // for its display-name fallback, `sendKinfolkMessage` takes the same two for
 // the message header, and `getMyAccess` calls `.select()` so it fetches ids and
 // no fields at all. Same shape #377 put on `the_411`.
 //
 // WRITE keeps its kinfolk branch. `onlyAllowedKinfolkFields()` diffs the
 // incoming payload against `resource.data`, which the rules engine evaluates
 // server-side whether or not the caller could have read the document, so
 // self-service contact updates still work with read denied.
    match /kinfolk/{kinfolkId} {
      allow read: if isOwner()
                  || (isTestAdmin() && kinfolkId == testScope());
      // #829: no client writes an Emergency Contact key, staff included. The
      // saveEmergencyContacts callable (Admin SDK, rules bypassed) is the only
      // writer, so its limits (at most two, not a household member, a valid
      // phone) cannot be skipped by a direct write. `diff()` needs an existing
      // document, so create checks the incoming keys instead. The kinfolk
      // branch stays update-only: on a create or delete its diff() has no
      // resource to compare and it never allowed either.
      allow create: if (isOwner() || (isTestAdmin() && kinfolkId == testScope()))
                    && !request.resource.data.keys().hasAny(emergencyContactKeys());
      allow update: if ((isOwner() || (isTestAdmin() && kinfolkId == testScope()))
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(emergencyContactKeys()))
                    || (isKinfolk() && kinfolkId == request.auth.token.kinfolkId
                        && onlyAllowedKinfolkFields());
      allow delete: if isOwner()
                    || (isTestAdmin() && kinfolkId == testScope());
    }

    match /kin/{docId} {
      allow read: if isOwner()
                  || (isKinfolk() && resource.data.kinfolkId == request.auth.token.kinfolkId)
                  || testOwnsExisting();
      allow create: if isOwner() || testOwnsIncoming();
      allow update: if isOwner() || testOwnsExisting();
      allow delete: if isOwner() || testOwnsExisting();
    }

    match /invoices/{invoiceId} {
      allow read: if isOwner()
                  || (isKinfolk() && resource.data.kinfolkId == request.auth.token.kinfolkId)
                  || testOwnsExisting();
      // Callable-only writes (ADR-0002): every invoice write, production and
      // TestMode sandbox alike, goes through a callable so the Invoice State
      // Classifier stamp (status + editScope) can never be skipped. The last
      // client-direct writer was removed in PR #105.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /kin_care_reports/{reportId} {
 // ISSUE #602: THERE IS NO KINFOLK BRANCH HERE, AND ITS ABSENCE IS THE
 // ENFORCEMENT. Until 2026-08-26 this line also carried
 //   || (isKinfolk() && resource.data.kinfolkId == request.auth.token.kinfolkId)
 // which handed a household the WHOLE report document, `gpsRoute` included --
 // the coordinate trail `getMyKinTales` deliberately strips on the way out.
 //
 // It could not be patched in place. A rule gates a DOCUMENT, never a field, so
 // no condition written here can withhold `gpsRoute` and still serve the
 // KinTale. Only removing the grant closes it.
 //
 // WHAT REPLACES IT IS NOT NEW. `functions/src/portal/getMyKinTales.ts` already
 // projects this collection field by field for the portal, and both shipping
 // portal clients already load KinTales through that callable and nothing else
 // (`mytribe/web/src/api/portal.ts`, `mytribe/src/commonMain/.../portal/PortalApi.kt`).
 // The grant was REACHABLE, not used. Two guard tests keep it that way, one per
 // client (`web/src/lib/reportDirectReads.test.ts`, `DirectReportReadTest.kt`).
 //
 // SAME MOVE AS `kin_care_sessions` BELOW (#584), `match /kinfolk/{kinfolkId}`
 // above, and #377 on `the_411` before both.
 //
 // THE COMMENTS READ BELOW IS UNAFFECTED, and that is the half most likely to
 // look broken. Its kinfolk branch resolves the parent report's `kinfolkId`
 // through `get()`, and a rules `get()` is not itself subject to rules, so it
 // never consulted this `allow read`. A household keeps reading the thread on
 // their own KinTale. `test/rules/kinCareReportRead.test.ts` proves both halves.
 //
 // STILL REACHABLE-BUT-UNUSED, and left alone on purpose: the comments rule's
 // own kinfolk branch. Comments are served by `getMyKinTaleComments` on both
 // clients, so that grant is no more used than this one was -- but a comment
 // carries no route, so removing it closes no leak, and a rules change is
 // cheapest to review one collection at a time.
      allow read: if isOwner() || testOwnsExisting();
      allow create: if isOwner() || testOwnsIncoming();
      allow update: if isOwner() || testOwnsExisting();
      allow delete: if isOwner() || testOwnsExisting();

      match /comments/{commentId} {
        allow read: if isOwner()
                    || (isKinfolk()
                        && get(/databases/$(database)/documents/kin_care_reports/$(reportId)).data.kinfolkId
                           == request.auth.token.kinfolkId)
                    || (isTestAdmin()
                        && get(/databases/$(database)/documents/kin_care_reports/$(reportId)).data.kinfolkId
                           == testScope());
 // Comments are server-written via callables (admin SDK bypasses rules).
 // Write stays closed for every client, test admin included.
        allow write: if false;
      }
    }

    match /kin_care_sessions/{sessionId} {
 // A3: the four OPERATOR status transitions on this collection
 // (Approve / Reject / Cancel / Mark Completed) moved server-side to the
 // `transitionBookingStatus` callable, which runs a real state machine
 // (functions/src/lib/bookingTransitions.ts) and writes an activity_log entry
 // on every path, refusals included. Before that they were a bare client
 // `updateDoc` authorized by `isAuntie()` alone
 // (auntieos-admin/src/api/bookingsWrite.ts:84), so any status could be set
 // from any status and nothing recorded who did it.
 //
 // The two functions below are what make the callable the ONLY path to a
 // terminal status: no client may put a session into COMPLETED or CANCELLED,
 // nor stamp `completedAt`, whatever claim it holds. Same shape as the
 // ADR-0002 ruling on invoices, which became callable-only for the test
 // sandbox as well as for production.
 //
 // NOT A BLANKET BAN ON `status`, deliberately. The field app drives the
 // in-visit lifecycle (SCHEDULED -> ON_MY_WAY -> ARRIVED -> DEPARTED, and
 // Undo Arrival back again) by direct patch from a phone that is regularly
 // offline mid-visit, and Firestore's offline write queue is what makes that
 // work at all. Those values stay client-writable. The two that decide
 // whether a visit HAPPENED, and therefore whether it is billable, do not.
 //
 // The alias spellings are listed too, so the guard cannot be walked around
 // by writing the older `CANCELED` or the MyTribe-side `REJECTED` that every
 // reader in this codebase already folds into CANCELLED.
      function terminalBookingStatus(s) {
        return s == 'COMPLETED' || s == 'CANCELLED' || s == 'CANCELED' || s == 'REJECTED';
      }
      function bookingTerminalFieldsUntouched() {
        return (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
                || !terminalBookingStatus(request.resource.data.status))
               && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['completedAt']);
      }

 // ISSUE #584: THERE IS NO KINFOLK BRANCH HERE, AND ITS ABSENCE IS THE
 // ENFORCEMENT. Until 2026-08-25 this line also carried
 //   || (isKinfolk() && resource.data.kinfolkId == request.auth.token.kinfolkId)
 // which handed a household the WHOLE session document: `gpsSummary`, with the
 // start and end coordinates and the full route, and alongside it `notes` (gate
 // codes, key locations), `kinfolkNotes`, `invoiceId`, `formValues`, and every
 // field AuntieOS adds to this collection next.
 //
 // #519 made `allowClientLocationSharing` real in the two callables that serve
 // route data and on the breadcrumbs read below. This grant was the hole left
 // over, and it could not be patched in place: a rule gates a DOCUMENT, never a
 // field, so no condition written here can withhold `gpsSummary` and still
 // serve the visit. Only removing the grant closes it.
 //
 // WHAT REPLACES IT IS NOT NEW. `functions/src/portal/getMyVisits.ts` already
 // projects this collection field by field for the portal and reads the sharing
 // switch once per call, and both shipping portal clients already load visits
 // through that callable and nothing else (`mytribe/web/src/api/portal.ts`,
 // `mytribe/src/commonMain/.../portal/PortalApi.kt`). The grant was REACHABLE,
 // not used: a kinfolk could open the raw document with the SDK, and no portal
 // screen depends on being able to. Two guard tests keep it that way, one per
 // client (`web/src/lib/sessionDirectReads.test.ts`, `DirectSessionReadTest.kt`).
 //
 // SAME MOVE AS `match /kinfolk/{kinfolkId}` ABOVE, and as #377 on `the_411`
 // before it: a collection whose every portal consumer is already a projecting
 // callable does not need a client read grant, and keeping one only widens what
 // a curious or compromised client can take.
 //
 // THE SAME HOLE ON `kin_care_reports` was named here when this shipped and has
 // since been closed by #602, in the block above. The two collections now carry
 // the same shape: operator and sandboxed test admin only, with every portal
 // read going through a projecting callable.
 //
 // THE BREADCRUMBS READ BELOW IS UNAFFECTED. Its kinfolk branch resolves the
 // parent session's `kinfolkId` through `get()`, and a rules `get()` is not
 // itself subject to rules, so it never consulted this `allow read`. Live
 // tracking keeps working, still gated on the operator's switch.
 // `test/rules/kinCareSessionRead.test.ts` proves both halves.
      allow read: if isOwner() || testOwnsExisting();
 // The create guard closes the delete-and-recreate walkaround: without it a
 // client reaches the same terminal state on the same doc id in two writes
 // instead of one.
      allow create: if (isOwner() || testOwnsIncoming())
                    && !(('status' in request.resource.data)
                         && terminalBookingStatus(request.resource.data.status));
      allow update: if (isOwner() || testOwnsExisting())
                    && bookingTerminalFieldsUntouched();
      allow delete: if isOwner() || testOwnsExisting();

 // GPS breadcrumbs subcollection - kinfolk reads only when the parent
 // session's kinfolkId matches their token. Used by MyTribe live tracking
 // (subscribe while ARRIVED) + replay (read full list once DEPARTED).
 // Writes are admin-only; the AuntieOS web/Android app writes one ping
 // per ~5s while a session is in flight.
 // ISSUE #519: the kinfolk branch is now also gated on the operator's "Let
 // kinfolk see visit locations" switch. This is the ONE kinfolk-facing
 // coordinate path that does not go through a callable (MyTribe subscribes to
 // this subcollection directly for live tracking), so a callable-only check
 // would have left the live map serving coordinates the operator had switched
 // off. An auntie's own read is untouched.
 //
 // ABSENT MEANS ON (`!= false`), matching every model default and the two
 // callables: reading a missing key as `false` would blank every kinfolk's live
 // map on the deploy that made the switch real, with no operator having chosen
 // it. THE COST is one extra `get()` per breadcrumb read evaluation, on a path
 // that already pays one to check the parent session's `kinfolkId`.
 //
 // `.data.get(key, true)` rather than `.data.allowClientLocationSharing`: in
 // Firestore rules, reading a key a document does not carry is an ERROR, not
 // `undefined`, and an error inside an `||` branch denies the whole read. Since
 // no settings document written before this change carries the key, the plain
 // property form would have denied every kinfolk breadcrumb read on deploy --
 // the exact lockout the "absent means ON" rule exists to prevent. The default
 // in the `get` IS that rule, expressed where rules can express it.
      function kinfolkLocationSharingOn() {
        return get(/databases/$(database)/documents/business_settings/business_settings)
                 .data.get('allowClientLocationSharing', true) != false;
      }
      match /breadcrumbs/{crumbId} {
        allow read: if isOwner()
                    || (isKinfolk()
                        && kinfolkLocationSharingOn()
                        && get(/databases/$(database)/documents/kin_care_sessions/$(sessionId)).data.kinfolkId
                           == request.auth.token.kinfolkId)
                    || (isTestAdmin()
                        && get(/databases/$(database)/documents/kin_care_sessions/$(sessionId)).data.kinfolkId
                           == testScope());
        allow write: if isOwner()
                     || (isTestAdmin()
                         && get(/databases/$(database)/documents/kin_care_sessions/$(sessionId)).data.kinfolkId
                            == testScope());
      }
    }

 // ── MyTribe collections ───────────────────────────────────────────────────
    match /clients/{uid} {
      allow read: if ownsClientRecord(uid) || isOwner();
 // kinfolkIds / familyIds are the tenant-boundary trust root: server-side
 // authorization (resolveKinfolkAccess) checks the requested tribe is in
 // clients/{uid}.kinfolkIds, and onClientsWrite mints the kinfolkId custom
 // claim from kinfolkIds[0]. They must be writable ONLY by Cloud Functions
 // (Admin SDK bypasses these rules: acceptInvite arrayUnion, provisionTribe).
 // A signed-in client must never self-assign them on create or update, or it
 // can pull every other tribe's data. The legit client write paths
 // (saveMyAccount, notificationPrefs) never touch these arrays. See
 // functions/test/rules/clients.test.ts.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['email'])
        && !request.resource.data.keys().hasAny(['kinfolkIds','familyIds']);
 // The allowlist below dropped 'stripeCustomerId', 'stripePaymentMethodId' and
 // 'email'. All three were client-writable and none is client-owned.
 //
 // The Stripe pair is the sharp one: NOTHING server-side writes either field
 // (the only other mentions in the tree are portal/account.ts and its test), and
 // portal/account.ts:58 derives `hasPaymentMethod: data['stripePaymentMethodId']
 // != null`. A client could therefore set the field to any string and make its
 // own Account screen report a saved card that does not exist at Stripe, right
 // up until a charge is attempted. Payment-instrument state must be asserted by
 // the payment backend, never by the payer.
 //
 // 'email' is server-owned per lib/schema.ts and is the address notification
 // dispatch resolves through (emailChannel reads clients/{uid}), so a
 // self-assigned value redirects the household's own mail.
      allow update: if ownsClientRecord(uid)
        && diffOnly([
          'displayName','phone','preferredContact','avatarUrl','homeAddress',
          'recoveryContacts','updatedAt',
          'backupEmail','backupPhone',
          'notificationPrefs','notificationPrefsUpdatedAt'
        ]);
      allow delete: if false;
    }

 // The /operators/{uid} match block was removed alongside isOperator(); see the
 // note on that helper above. It had no writer and no reader anywhere in the
 // tree, so with the helper gone it granted read on a collection nothing asks
 // for. Deleting it default-denies the path, which is the correct end state for
 // a retired grants collection that still holds one stale prod document.

    match /families/{fid} {
      allow read: if activeMember(fid) || isOwner();
      allow create, delete: if false;
      allow update: if isPrimary(fid) && diffOnly(['displayName','updatedAt']);

 // RULING (household secondary permissions): "Primary kinfolk is allowed to set
 // the permissions of the secondary, including billing if they want. having
 // household access is another main reason to have a secondary (THE OTHER PET
 // PARENT). besides admin, primary kinfolk can set permissions for the
 // secondary."
 //
 // This branch used to pin billing_full, kintales_only AND home_access to their
 // existing values, so a PRIMARY could move only messaging_direct,
 // messaging_group and kin_edit by direct write. Two of those three pins
 // contradicted the ruling outright, and home_access contradicted this project's
 // own callable as well: `updateSecondaryPermissions` has always accepted it, so
 // the same grant succeeded through a Function and failed through the SDK. The
 // rules were the wrong half of that disagreement, not the callable.
 //
 // billing_full and home_access are now movable by the household PRIMARY, here
 // and in `updateSecondaryPermissions`, which say the same thing.
 //
 // What still holds, and is the boundary that matters:
 //   * `affectedKeys().hasOnly([...])` excludes `role` and `status`, so a PRIMARY
 //     can neither promote a SECONDARY nor escalate themselves. There is no
 //     `admin` key in `permissions` to grant; admin authority is the `admin`
 //     custom claim, which lives outside Firestore and is written by exactly one
 //     admin-gated callable that reads nothing under families/*.
 //   * kintales_only stays pinned. That is a product invariant, not an authority
 //     boundary: every mint path force-sets it true, `setMemberPermissions`
 //     omits it from its schema entirely, and both admin clients render it as a
 //     locked control. NOBODY turns it off, primary or operator.
 //   * create/delete stay hard-false for every caller including isAuntie(), so
 //     membership itself is still minted only by the Admin SDK.
      match /members/{uid} {
        allow read: if activeMember(fid) || isOwner();
        allow create, delete: if false;
        allow update: if isPrimary(fid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['secondaryLabel','permissions','updatedAt'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions'])
              || request.resource.data.permissions.kintales_only == resource.data.permissions.kintales_only);
      }

 // Secondary CONTACTS: people a household can be reached through who hold no
 // portal account (operator ruling, 2026-09-12). Closed to every client in both
 // directions, on purpose, and deliberately NOT modelled on /members above:
 //
 //   * A contact has no uid, so `activeMember(fid)` cannot answer "is this row
 //     about me" and there is no self-service branch to write. Every read and
 //     write goes through listHouseholdContacts / saveHouseholdContact /
 //     removeHouseholdContact, which gate on PRIMARY-or-staff exactly as the
 //     roster callables do; the Admin SDK bypasses these rules.
 //   * A contact row carries a name, a phone and sometimes an email for someone
 //     who never agreed to a portal account. Serving that to every active member
 //     by direct SDK read would be a wider audience than the callable grants,
 //     for no screen that asks for it.
      match /contacts/{contactId} {
        allow read, write: if false;
      }

      match /kin/{kinId} {
        allow read: if activeMember(fid) || isOwner();
        allow create, delete: if hasPerm(fid, 'kin_edit');
        allow update: if hasPerm(fid, 'kin_edit')
          || (activeMember(fid) && diffOnly([
            'feedingInstructions','walkingInstructions','sitterNotes',
            'emergencyNotes','medications','allergies','updatedAt'
          ]));
      }

      match /kinfolk/{kinfolkId} {
        allow read: if activeMember(fid) || isOwner();
        allow create, update, delete: if isPrimary(fid)
          || (activeMember(fid) && resource.data.id == request.auth.uid
              && diffOnly([
                'phone','email','avatarUrl','preferredContactMethod','notes','updatedAt'
              ]));
      }

 // ── Booking envelope (parent) + nested per-visit KinCares ──────────────
 // ENVELOPE MODEL: the parent `bookings/{batchId}` doc is the envelope that
 // tracks the request batch (status rollups, counts, kin/service identity).
 // Each individual visit lives at `bookings/{batchId}/kinCares/{visitId}`.
 // The envelope itself only takes kinfolk edits to notes/updatedAt; per-visit
 // mutations (status, title, window, notes) happen on the kinCare doc.
      match /bookings/{batchId} {
        allow read: if activeMember(fid) || isOwner();
        allow create: if activeMember(fid)
          && request.resource.data.familyId == fid
          && request.resource.data.targetType in ['KIN','KINFOLK']
          && (hasPerm(fid,'billing_full')
              || (!affects(invoiceKeys()) && !affects(restrictedSitterKeys())));
        allow update: if isOwner()
          || hasPerm(fid,'billing_full')
          || (activeMember(fid) && invoiceFieldsUnchanged() && sitterFieldsUnchanged()
              && diffOnly(['notes','updatedAt']));
        allow delete: if hasPerm(fid,'billing_full');

 // Per-visit KinCare docs. Same create gate as the envelope. Kinfolks may
 // mutate the visit's own fields (status/notes/title/window); the
 // isAuntie() update branch is the AuntieOS write-back path that lands
 // visitProgress, auntieDisplayName, sourceBookingId, sessionId, etc.
        match /kinCares/{visitId} {
          allow read: if activeMember(fid) || isOwner();
          allow create: if activeMember(fid)
            && request.resource.data.familyId == fid
            && request.resource.data.targetType in ['KIN','KINFOLK']
            && (hasPerm(fid,'billing_full')
                || (!affects(invoiceKeys()) && !affects(restrictedSitterKeys())));
          allow update: if isOwner()
            || hasPerm(fid,'billing_full')
            || (activeMember(fid) && invoiceFieldsUnchanged() && sitterFieldsUnchanged()
                && diffOnly(['status','notes','title','window','updatedAt']));
          allow delete: if hasPerm(fid,'billing_full');

 // KinCare notes, server-written via addBookingNote callable.
 // Trigger fires kincare.note.kinfolk only when authorRole='kinfolk'.
          match /notes/{noteId} {
            allow read: if activeMember(fid) || isOwner();
            allow write: if false;
          }

 // Admin-internal KinCare notes, server-written via
 // addInternalBookingNote callable. PATH-level boundary keeps kinfolk
 // denied entirely (no field masking needed). Visible to staff; not
 // saved to KinTale.
          match /internalNotes/{noteId} {
            allow read: if isOwner();
            allow write: if false;
          }
        }
      }

      match /ratings/{ratingId} {
 // Ratings - server-written via submitRating callable. Trigger branches
 // score to rating.submitted.bad (≤3) or rating.submitted.good (≥4).
        allow read: if activeMember(fid) || isOwner();
        allow write: if false;
      }

      match /visitEvents/{id} {
        allow read: if activeMember(fid) || isOwner();
        allow create, update, delete: if false;
      }

      match /bookingLocks/{id} {
        allow read: if activeMember(fid) || isOwner();
        allow create, update, delete: if false;
      }

      match /invoices/{id} {
        allow read: if activeMember(fid) || isOwner();
        allow create, update, delete: if isOwner();
      }

 // Lockbox data: gate/door code, key location, Wi-Fi password, plus whatever
 // custom fields the operator has defined (alarm codes turn up here). The read
 // gate is unchanged and still the narrowest one in the file - home_access is
 // the only permission a SECONDARY can hold that unlocks it.
 //
 // Writes are now callable-only. portal/saveHomeAccess.ts:53 is the real and
 // only writer: it re-checks tribe membership against clients/{uid}.kinfolkIds,
 // re-checks the home_access perm through requireKinfolkPerm, validates the
 // payload with zod, stamps updatedByUid, logs portal.homeAccess.saved, and
 // writes families/{kinfolkId}/homeAccess/current with the Admin SDK (which
 // bypasses these rules). No client uses the direct path - the portal calls the
 // callable via tribeApi.saveHomeAccess and does no direct Firestore writes at
 // all, and no admin client touches this subcollection.
 //
 // The direct grant bought nothing and cost the audit trail: a client write
 // lands with no updatedByUid, no validation and no log line, on the one
 // document where "who changed the door code, and when" is the whole question.
      match /homeAccess/{id} {
        allow read: if hasPerm(fid, 'home_access') || isOwner();
        allow create, update, delete: if false;
      }

      match /themeConfig/{id} {
        allow read: if activeMember(fid) || isOwner();
        allow create, delete: if false;
        allow update: if isPrimary(fid) && diffOnly(['kinfolkOverrides','updatedAt']);
      }

      match /mediaGallery/{id} {
        allow read: if activeMember(fid) || isOwner();
        allow create, update: if hasPerm(fid, 'kin_edit');
        allow delete: if isPrimary(fid);
      }

      match /messages/{threadId} {
        allow read, update: if activeMember(fid)
          && request.auth.uid in resource.data.participantUids
          && (resource.data.kind == 'DIRECT'
              || (resource.data.kind == 'GROUP' && hasPerm(fid,'messaging_group')));
        allow create: if activeMember(fid)
          && request.auth.uid in request.resource.data.participantUids
          && ((request.resource.data.kind == 'DIRECT' && hasPerm(fid,'messaging_direct'))
              || (request.resource.data.kind == 'GROUP' && hasPerm(fid,'messaging_group')));
        allow delete: if false;

        match /items/{msgId} {
          allow read: if activeMember(fid)
            && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)/messages/$(threadId)).data.participantUids;
          allow create: if activeMember(fid)
            && request.auth.uid == request.resource.data.authorUid
            && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)/messages/$(threadId)).data.participantUids;
          allow update, delete: if false;
        }
      }

      match /secrets/{doc} { allow read, write: if false; }

 // LEGACY - superseded by flat `kin_care_reports` collection per HANDOFF 2026-05-18.
 // Retained as reserved/archived path per operator direction 2026-05-19.
 // No active readers/writers; rule kept defensive in case legacy data resurfaces.
      match /kinTales/{kinTaleId} {
        allow read: if activeMember(fid) || isOwner();
        allow write: if isOwner();

        match /comments/{commentId} {
          allow read: if activeMember(fid) || isOwner();
          allow write: if isOwner();
        }
      }
    }

 // ── kinCares collection-group read (AuntieOS Incoming-requests queue) ──────
 // The Booking screen runs `collectionGroup('kinCares').where('status','==',
 // 'REQUESTED')` to surface new booking requests across every family. Firestore
 // does NOT authorize a collection-group query from the depth-specific
 // `families/{fid}/bookings/{batchId}/kinCares/{visitId}` rule alone, so the
 // query was denied with "Missing or insufficient permissions" in prod
 // (2026-06-08). This recursive-wildcard rule grants admins read at the
 // collection-group scope. It is intentionally SCOPED to `kinCares` (not a
 // `/{document=**}` catch-all) and READ-ONLY, so it cannot override any
 // `allow … if false` deny elsewhere. Per-visit create/update/delete stay on
 // the depth-specific rule above. NOTE: a collection-group single-field index
 // on kinCares.status may also be required at runtime.
    match /{path=**}/kinCares/{visitId} {
      allow read: if isOwner();
    }

    match /inviteRequests/{id} {
 // WARNING-17: the invitee branch must require a VERIFIED email claim. An
 // unverified email is attacker-controllable (sign up with any address,
 // unverified), so gating only on token.email leaked invite details to anyone
 // who could claim the address. email_verified == true closes the disclosure.
      allow read: if isOwner()
        || (signedIn()
            && (request.auth.uid == resource.data.primaryUid
                || (request.auth.token.email_verified == true
                    && resource.data.invitedEmail == request.auth.token.email)));
      allow create, update, delete: if false;
    }

 // Device tokens for push. The collection is `fcm_tokens` (snake): every writer
 // and reader uses that name (registerFcmToken.ts, pushChannel.ts,
 // broadcastMessage.ts, rotateOldFcmTokens.ts). This rule previously matched
 // `fcmTokens` (camel), which matches NOTHING, and with no catch-all in this
 // file the real collection was default-deny. Functions never noticed because
 // the Admin SDK bypasses rules; the AuntieOS Android app did, silently, on
 // every token save.
 //
 // Closed to clients on purpose. Registration goes through the
 // `registerFcmToken` / `unregisterFcmToken` callables, which own the doc id
 // (the token, deduped) and stamp `uid`. Both apps use them. A direct client
 // write cannot get that shape right: pushChannel and broadcastMessage query
 // `.where('uid','==',...)`, so a doc without `uid` is invisible to every send
 // even when the write succeeds.
    match /fcm_tokens/{id} {
      allow read, write: if false;
    }

    match /sharedKinTales/{id}     { allow read, write: if false; }
    match /auditLog/{id}           { allow read, write: if false; }
 // activity_log (canonical, 2026-05-19): admin-only via isAuntie() for
 // read+create. Update/delete NEVER permitted - forensic non-repudiation,
 // immutable audit history. MyTribe Functions write via admin SDK which
 // bypasses rules; AuntieOS Android `AuntieRepository.logActivity` and the
 // AuntieOS Web `jsAddDoc("activity_log", ...)` paths both create-only via
 // `.add()` / batched `set()` on a fresh auto-id ref, so this rule keeps
 // existing writers green while sealing off any mutation pathway.
    match /activity_log/{id} {
      allow read: if isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }
 // activity_log_chain_head/{current}: holds the SHA-256 hash-chain head
 // pointer that seals every audit write (writeAuditEntry runs inside a
 // Firestore tx that reads + advances this doc). Clients NEVER touch it;
 // admin SDK writes from Functions bypass these rules but those writes
 // are the only authorised path. Admin UIs can read for ops dashboards.
    match /activity_log_chain_head/{id} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /leadRequests/{id}       { allow read, write: if false; }
    match /emailTemplates/{id}     { allow read, write: if false; }
    match /smsTemplates/{id}       { allow read, write: if false; }
    match /pushTemplates/{id}      { allow read, write: if false; }
    match /notificationTemplateBindings/{id} { allow read, write: if false; }
    match /recoveryRequests/{id}   { allow read, write: if false; }
    match /migrationReports/{id}   { allow read, write: if false; }

 // ── Notification subsystem (server-only writes; recipient-only reads) ─────
 // All notifications collections are written by Cloud Functions only - clients
 // never write. Recipients can read their own dispatches for UI display.
    match /notifications/{id} {
 // AuntieOS admin console lists the whole collection (unfiltered listen);
 // kinfolk (MyTribe) may still read only their own dispatches.
 //
 // Both gates carried a third branch, `isTestAdmin() && recipientUid ==
 // request.auth.uid`, added by NOTE-55 to "mirror the parent's three-branch
 // shape". It could never decide anything: isTestAdmin() begins with
 // `request.auth != null`, so its condition is a strict SUBSET of the recipient
 // branch above it, which admits any signed-in caller reading their own
 // dispatch - test admin included. Dropped from both. Sandbox behaviour is
 // unchanged; what goes away is a branch that reads as an extra grant while
 // granting nothing, and the get() it re-ran on the channels gate.
      allow read: if isOwner()
                  || (signedIn() && resource.data.recipientUid == request.auth.uid);
      allow write: if false;
 //
 // THE `channels` SUBCOLLECTION MATCH THAT SAT HERE IS GONE (operator ruling
 // R5, 2026-08-03). Per-channel delivery state - status, providerMessageId,
 // sentAt, errorMessage, attempts - is pipeline plumbing, and structurally
 // authorising it beneath the INBOX document is part of what made the inbox
 // look like a workflow queue to every client that read it. Those subdocs now
 // live under `notificationDispatch/{id}/channels/{channel}` (below).
 //
 // Legacy `notifications/{id}/channels/*` subdocs written before the split are
 // now unreadable by clients. That is deliberate and costs nothing: no client
 // on any platform ever queried them (the only reader was the Cloud Function
 // trigger, and Admin SDK writes bypass rules entirely). The backfill script
 // `mytribe/scripts/backfillNotificationDeliverySplit.ts` relocates them.
    }
 // ── Delivery work orders (R5) ────────────────────────────────────────────
 // `notificationDispatch/{id}` is id-matched to `notifications/{id}` and holds
 // the delivery pipeline: mode, channel list, dispatch status, and the
 // per-channel subdocs beneath it. Same recipient gate as the notification it
 // delivers, so nobody gains or loses visibility by the split - what changes is
 // that a client reading its INBOX no longer receives workflow fields it then
 // rendered as card content.
    match /notificationDispatch/{id} {
      allow read: if isOwner()
                  || (signedIn() && resource.data.recipientUid == request.auth.uid);
      allow write: if false;
 // Resolved through the parent work order, which carries `recipientUid`
 // directly - no cross-collection get() into `notifications/` is needed.
      match /channels/{channelId} {
        allow read: if isOwner()
          || (signedIn()
              && get(/databases/$(database)/documents/notificationDispatch/$(id)).data.recipientUid == request.auth.uid);
        allow write: if false;
      }
    }
    match /pendingNotifications/{id} {
      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow write: if false;
    }
    match /scheduledNotifications/{id} {
      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow write: if false;
    }
    match /notificationBatch/{uid}/{batchKey}/{id} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow write: if false;
    }
    match /businessSettings/{doc} {
 // Admin-only; AuntieOS web/admin reads + writes business config docs.
      allow read, write: if isOwner();
    }

 // ── Dynamic form schemas (global, version-bumped by saveFormSchema fn) ───
 // Read by every signed-in kinfolk so MyTribe TribeScreen / KinScreen /
 // AccountSettings can render server-authored field definitions. Writes
 // gated to AuntieOS admins; the saveFormSchema callable additionally
 // re-validates via isAuntieOperator allowlist.
    match /formSchemas/{schemaId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isOwner();
    }

 // ── AuntieOS operational collections (admin-only enumeration) ───────────
 //
 // ⚠️ DO NOT REPLACE WITH `match /{document=**}` CATCH-ALL.
 //
 // Firestore Rules are UNION-OR'd: a catch-all `allow … if isAuntie()` wins
 // over every explicit `allow … if false` higher in the file (e.g. the
 // families/{fid}/secrets/{doc} deny), letting admin claims read and write
 // protected paths despite the explicit deny. Enumerate every operational
 // collection instead - anything not listed gets default-deny.
 //
 // A SECOND `match /activity_log/{id}` block sat here, byte-equivalent in effect
 // to the documented one above. Deleted 2026-07-23. Firestore UNIONs matching
 // rules, so a duplicate is not merely redundant: any future narrowing of the
 // canonical block (say, scoping read to the writing operator) would have been
 // silently re-granted in full by this copy, and the audit trail's own rule is
 // the last place a change should fail to take effect. One block, one place to
 // edit, and the non-repudiation rationale lives with it.
    // booking_time_slots: Google Calendar "Busy" blocks, written server-side by
    // syncGoogleCalendarBusyEvents (admin SDK bypasses rules). The Schedule grid
    // reads them. Had NO rule => default-deny => the read failed with
    // "Missing or insufficient permissions" and the "Couldn't load busy blocks"
    // banner fired even when calendar sync was never set up (prod 2026-06-08).
    // Admin read only; client writes denied (only the sync function writes).
    match /booking_time_slots/{id}              { allow read: if isOwner(); allow write: if false; }
 // Service-Management catalog collections (WARNING-16): the AuntieOS Android
 // client reads/writes these directly from Settings. They had NO rule, so the
 // direct reads/writes hit default-deny and failed with permission errors. Any
 // signed-in user may READ the service catalog (kinfolk price lists render from
 // it); only admins may WRITE. promo_codes is the exception - both read and
 // write are admin-only so kinfolk cannot enumerate unredeemed codes.
    match /base_services/{id}                   { allow read: if signedIn(); allow write: if isOwner(); }
    match /supplemental_services/{id}           { allow read: if signedIn(); allow write: if isOwner(); }
    match /surcharges/{id}                      { allow read: if signedIn(); allow write: if isOwner(); }
    match /discounts/{id}                       { allow read: if signedIn(); allow write: if isOwner(); }
    match /business_hours/{id}                  { allow read: if signedIn(); allow write: if isOwner(); }
    match /promo_codes/{id}                     { allow read: if isOwner(); allow write: if isOwner(); }
    match /calls_log/{id}                       { allow read, write: if isOwner(); }
    // Stage-0I sandbox: a test admin may READ its own kinfolk's dossier (the wildcard
    // doc id IS the kinfolkId, and dossiers are keyed one-per-kinfolk == testScope), so
    // the Kinfolk-profile dossier card renders instead of a false permission banner.
    // Single-doc read => this rule alone fully fixes it. Writes stay admin-only.
    match /dossiers/{kinfolkId} {
      allow read: if isOwner() || (isTestAdmin() && kinfolkId == testScope());
      allow write: if isOwner();
    }
    match /dynamic_field_values/{id}            { allow read, write: if isOwner(); }
 // `dynamic_fields` had a rule here. Deleted 2026-07-23: the field-authoring
 // system it served is retired. migrate_dynamic_fields_to_form_schemas.py folded
 // those docs into formSchemas and states "dynamic_fields UI/code is retired in
 // the app"; the Settings section, DynamicFieldsCard.kt and the Android screen +
 // VM all went with it. What is left is unreachable expect/actual plumbing
 // (FirestoreInterop.wasmJs.kt / .jvm.kt) that the handoff explicitly kept
 // "unused" because the model was entangled - no screen calls
 // dynamicFieldsStream / createDynamicField / updateDynamicField /
 // archiveDynamicField, so no live read or write hits this path.
 //
 // NOT the same collections: `dynamic_field_values` above and
 // `field_definitions` below ARE live (AuntieRepository.kt reads and writes both
 // directly from Android). Their near-identical names are exactly why this rule
 // survived the retirement; do not remove them by association.
    match /emails/{id}                          { allow read, write: if isOwner(); }
    match /field_definitions/{id}               { allow read, write: if isOwner(); }
    // Stage-0I sandbox: a test admin may READ its own tribe's generated drafts. The
    // doc's own-tribe key is the snake_case `kinfolk_id` field (written by
    // web/functions/generate.js), NOT camelCase kinfolkId, so testOwnsExisting() does
    // NOT apply — this is a bespoke branch. RULE ALONE IS NOT ENOUGH: the client's
    // list listen MUST also constrain the query to where(kinfolk_id == testScope) or
    // an unfiltered list is still denied (see generatedDraftsStream). Writes admin-only.
    match /generated_drafts/{id} {
      allow read: if isOwner() || (isTestAdmin() && resource.data.kinfolk_id == testScope());
      allow write: if isOwner();
    }
    match /household_data/{id}                  { allow read, write: if isOwner(); }
 // The household bank (issue #461): the household's own reconciled record, the
 // peer of a kinfolk dossier and a kin 411. ADMIN-ONLY, the same standing ruling
 // that governs those two: kinfolk never see it, and no portal callable projects
 // a field off it.
 //
 // Same shape as /dossiers above, and for the same reason: the wildcard doc id IS
 // the household id (the anchoring kinfolkId, which is what upsert_household_bank
 // writes), so a test admin's single-doc read can be scoped by the doc id alone.
 // Writes stay admin-only; the nightly reconcile job writes through the Admin SDK.
    match /household_bank/{householdId} {
      allow read: if isOwner() || (isTestAdmin() && householdId == testScope());
      allow write: if isOwner();
    }
 // Global KinTale template catalog: test admin may READ (so the KinTale
 // composer renders), never write. Writes stay admin-only.
    match /kintale_templates/{id} {
      allow read: if isOwner() || isTestAdmin();
      allow write: if isOwner();
    }
    match /location_checkpoints/{id}            { allow read, write: if isOwner(); }
    match /location_sharing_preferences/{id}    { allow read, write: if isOwner(); }
    match /media_albums/{id}                    { allow read, write: if isOwner(); }
 // Scoped for the test-admin sandbox: read+write only docs whose kinfolkId
 // matches testScope() (create checks the incoming payload). Live media /
 // payments stay unreachable.
 //
 // `taggedKinIds` (which Kin are in this photo) is SERVER-BOUND: the
 // saveMediaTags callable is its only writer (#447). Android used to patch the
 // field straight from the client, which meant nothing checked that a tagged
 // kin existed or even belonged to the household whose photo it is, and no
 // audit entry was written. The callable enforces both and the admin SDK
 // bypasses these rules, so denying the key here leaves exactly one way in.
 // Every OTHER field on the doc keeps its existing client `update` path, and
 // the upload pipelines keep their client `create`: `api/mediaUpload.ts`,
 // `JvmMediaUpload` and Android's repository all addDoc straight into this
 // collection, and #397 S3 caption editing writes `description` the same way.
 //
 // DELETE IS CALLABLE-ONLY (#577). Deleting a media row is a two-collection
 // invariant: setMediaProfilePhoto stamps kinfolk/kin `.profilePictureUrl` (or
 // users `.photoUrl`) with THIS doc's storageUrl, so dropping the row from a
 // client leaves the profile rendering a photo the gallery has forgotten, with
 // nothing left in the app able to clear that field again - and no audit entry,
 // at the one moment the deleted row was the only record the file ever existed.
 // The deleteMediaFile callable does both writes in one batch, clears the photo
 // field only when it actually points at this file, refuses a wrong-entity id,
 // and writes MEDIA_FILE_DELETED. The admin SDK bypasses these rules, so
 // `if false` leaves exactly one way in - the same stance training_documents
 // above already takes.
 //
 // PR #568 shipped that callable and repointed React and Android at it but left
 // this line open on purpose, because the desktop admin was still writing
 // `media_files` from the client. It no longer is (#577), so the line closes
 // here, in the same change that removes the last client writer.
    match /media_files/{id} {
      allow read: if isOwner() || testOwnsExisting();
      allow create: if isOwner() || testOwnsIncoming();
      allow update: if (isOwner() || testOwnsExisting())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['taggedKinIds']);
      allow delete: if false;
    }
    match /payments/{id} {
      allow read: if isOwner() || testOwnsExisting();
      allow create: if isOwner() || testOwnsIncoming();
      allow update: if isOwner() || testOwnsExisting();
      allow delete: if isOwner() || testOwnsExisting();
    }
    match /sms_messages/{id}                    { allow read, write: if isOwner(); }
    match /the_411/{kinfolkId}                  { allow read, write: if isOwner(); }
 // Tribal Intel (spec 23): admins READ here, but writes go ONLY through the
 // server-bound createTrainingDocument / updateTrainingDocument /
 // deleteTrainingDocument callables (admin SDK bypasses rules), so the audit
 // entry is structurally bound to every mutation. Direct client writes denied.
    match /training_documents/{id}              { allow read: if isOwner(); allow write: if false; }
    match /users/{uid}                          { allow read, write: if isOwner(); }
    match /visit_logs/{id}                      { allow read, write: if isOwner(); }
    match /visit_routes/{id}                    { allow read, write: if isOwner(); }
    match /voicemails/{id} {
 // Issue #581: Mark read and Dismiss used to be a bare client write authorized
 // by isAuntie() alone, with no floor under it. A stray tap on a voicemail
 // that had ALREADY been replied to silently rewrote `replyStatus` back to
 // `read`/`dismissed` and blanked `repliedAt`/`replyLogId`, destroying the
 // only record of who answered it and when, with no confirmation and no way
 // back. All three clients (web SDK, Android SDK, desktop's REST PATCH -
 // JvmFirestoreRest carries the caller's own Firebase ID token, so this rule
 // governs it too) write the same three keys through this one grant, so this
 // is the one place the floor can be enforced for all of them at once rather
 // than three UI checks that can each be a stray tap or a future regression
 // away from clobbering the record again.
 //
 // A re-reply is deliberately NOT blocked: the new write is still allowed to
 // move repliedAt/replyLogId forward as long as it KEEPS replyStatus at
 // 'replied' (answering a voicemail a second time is legitimate and should
 // update the record). What is blocked is moving AWAY from 'replied' at all -
 // Mark read and Dismiss never send 'replied', so neither can touch a
 // replied voicemail's status or its two reply fields, full stop.
 //
 // `!('replyStatus' in resource.data)` covers a voicemail written before the
 // field existed: with no replyStatus to protect, the write is ungated, same
 // as every other legacy-shape rule in this file.
      function voicemailReplyGuardSatisfied() {
        return !('replyStatus' in resource.data)
          || resource.data.replyStatus != 'replied'
          || request.resource.data.replyStatus == 'replied';
      }
      allow read: if isOwner();
      allow create: if isOwner();
      allow update: if isOwner() && voicemailReplyGuardSatisfied();
      allow delete: if isOwner();
    }
 // Dashboard-widget collections (AO-40/41/39): admin read, writes callable-only.
 //
 // The comment here used to claim mutations "normally flow through" the
 // server-bound admin callables (logExpense / adjustSupply / upsertSupply /
 // upsertExpiration), which is what binds an activity_log entry to every
 // mutation - and then granted `write: if isAuntie()` anyway, so an admin client
 // could write these docs directly and produce no audit entry at all. "Normally"
 // is not an invariant. Closed 2026-07-23.
 //
 // Nothing regresses: no client writes these paths directly. The React admin's
 // src/api/{expenses,supplies,expirations}.ts import only `call` from lib/fns;
 // AuntieOS Android goes through getHttpsCallable("listExpenses" /
 // "adjustSupply" / "listExpirations" / ...); the Compose web client decodes the
 // same callable bodies. This is the shape already used by training_documents,
 // audience_segments and broadcasts for the same reason.
    match /expenses/{id}                        { allow read: if isOwner(); allow write: if false; }
    match /supplies/{id}                        { allow read: if isOwner(); allow write: if false; }
    match /expirations/{id}                     { allow read: if isOwner(); allow write: if false; }
 // Server-written rate-limit + Stripe dedupe ledgers. Admin reads for
 // monitoring; client writes denied (admin SDK in Cloud Functions bypasses).
    match /ipRateLimits/{key}                   { allow read: if isOwner(); allow write: if false; }
    match /failedLoginEmailRateLimits/{key}     { allow read: if isOwner(); allow write: if false; }
 // #886: failed sign-ins against addresses that are not accounts, keyed by email
 // hash. Written only by recordFailedLogin through the admin SDK.
    match /unknownLoginAttempts/{id}            { allow read: if isOwner(); allow write: if false; }
    match /passwordResetEmailRateLimits/{key}   { allow read: if isOwner(); allow write: if false; }
    match /stripeEvents/{eventId}               { allow read: if isOwner(); allow write: if false; }
 // `stripeEvents` is keyed per EVENT; this one is keyed per PAYMENTINTENT, so
 // the two events a single card payment delivers apply exactly once between
 // them. See `billing/stripeWebhook.ts`.
    match /stripePayments/{paymentIntentId}     { allow read: if isOwner(); allow write: if false; }
 // Chargebacks, keyed per DISPUTE. Server-written like its two siblings: a
 // client that could forge or edit one of these could clear the only record
 // that a settled payment is contested, on an invoice that deliberately keeps
 // reading paid. See `billing/stripeDispute.ts`.
    match /stripeDisputes/{disputeId}           { allow read: if isOwner(); allow write: if false; }
 // `n8nIpRateLimits` had a rule here. Deleted 2026-07-23 with the n8n
 // retirement: its only writer is the Admin SDK inside
 // auntieos-admin/web/functions/index.js (which bypasses these rules either
 // way), and no client, dashboard or test ever read the collection - the read
 // grant existed "for monitoring" that was never built. Nothing observes the
 // path, so default-deny is the honest state.
    match /kinTaleNotifications/{reportId}      { allow read: if isOwner(); allow write: if false; }
    match /securityRateLimits/{key}             { allow read: if isOwner(); allow write: if false; }
    match /securityIncidents/{id}               { allow read: if isOwner(); allow write: if false; }
 // Stage 2 step 6 (Communicate broadcast): saved audience segments + sent
 // broadcast records. All mutation goes through the admin-gated callables
 // (saveAudienceSegment / deleteAudienceSegment / broadcastMessage; admin SDK
 // bypasses rules), so direct client writes are denied. Admins read for
 // inspection; the client list path uses the listAudienceSegments callable.
    match /audience_segments/{id}               { allow read: if isOwner(); allow write: if false; }
    match /broadcasts/{id}                      { allow read: if isOwner(); allow write: if false; }
 // Stage 2 step 7 (Inbox conversations / Message Auntie): two-way kinfolk<->auntie
 // threads. ALL writes are admin-gated (listConversations / getConversationThread
 // / replyToConversation / markConversationRead) or portal (sendKinfolkMessage /
 // getMyConversation / markThreadRead) callables; the Admin SDK bypasses rules —
 // write stays closed for every client. S5: MyTribe portal's Messages screen adds
 // a realtime `onSnapshot` listener (web/src/lib/messagesListener.ts, same pattern
 // as kin_care_sessions/{id}/breadcrumbs above) so new messages appear live
 // without polling getMyConversation — that needs a scoped CLIENT READ, gated
 // identically to breadcrumbs: a kinfolk may read only their own household's
 // thread (kinfolkId == their token claim), matching what getMyConversation
 // already returns them non-realtime.
    match /conversations/{kinfolkId} {
      allow read: if isOwner() || (isKinfolk() && kinfolkId == request.auth.token.kinfolkId);
      allow write: if false;
      match /messages/{messageId} {
        allow read: if isOwner() || (isKinfolk() && kinfolkId == request.auth.token.kinfolkId);
        allow write: if false;
      }
    }
  }
}
