<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".KinfolkPortalApplication"
        android:label="MyTribe"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Sentry: disable auto-init ContentProvider. Init is performed from
             KinfolkPortalApplication.onCreate AFTER the defensive crash handler
             is installed so any crash inside Sentry.init lands on disk. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="kinfolk.tribetails.com" />
                <data android:pathPrefix="/claim/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mytribe" />
                <data android:host="claim" />
            </intent-filter>
            <!-- Share viewer: https://kinfolk.tribetails.com/share/<token> -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="kinfolk.tribetails.com" />
                <data android:pathPrefix="/share/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mytribe" />
                <data android:host="share" />
            </intent-filter>
            <!-- #2401: where Stripe returns a card payment made from this app.
                 https://kinfolk.tribetails.com/app/invoices/<id>[?checkout=done].
                 NOT the web portal's own /invoices/: claiming that would pull the
                 web portal's return from Stripe, and every invoice link in an
                 email, out of the browser. Verified by the same assetlinks.json as
                 the filters above. The server only accepts a return address on
                 the portal's origins, so this is the address Stripe is given. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="kinfolk.tribetails.com" />
                <data android:pathPrefix="/app/invoices/" />
            </intent-filter>
            <!-- The same return in the app's own scheme, mytribe://invoices/<id>.
                 The portal's signed-out return page uses it for its Open MyTribe
                 button when the browser kept the https address. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mytribe" />
                <data android:host="invoices" />
            </intent-filter>
            <!-- #2427: where Stripe returns a card setup made from this app,
                 https://kinfolk.tribetails.com/app/account[?billing=saved].
                 An exact path, NOT the web portal's own /account: claiming that
                 would pull the web portal's return from Stripe, and the email
                 action links under /account/, out of the browser. Verified by
                 the same assetlinks.json as the filters above. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="kinfolk.tribetails.com" />
                <data android:path="/app/account" />
            </intent-filter>
            <!-- The same return in the app's own scheme, mytribe://account, for
                 the Open MyTribe button on the portal's signed-out return page. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mytribe" />
                <data android:host="account" />
            </intent-filter>
            <!-- #905: Firebase email action links. The project has ONE action URL,
                 https://kinfolk.tribetails.com/account/secure-reset, and the portal
                 web page also answers at /account/action. Every auth email (reset,
                 verify, email change, recover) opens one of these, and none carries
                 an email param. autoVerify needs
                 https://kinfolk.tribetails.com/.well-known/assetlinks.json, served
                 from mytribe/web/public/.well-known/. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="kinfolk.tribetails.com" />
                <data android:path="/account/secure-reset" />
                <data android:path="/account/action" />
            </intent-filter>
        </activity>

        <service
            android:name=".fcm.KinfolkFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
