<?xml version="1.0" encoding="utf-8"?>
<!-- Real packaged launcher icon. The manifest previously pointed android:icon at
     the framework drawable @android:drawable/sym_def_app_icon, which is not in the
     APK's resource table; App Distribution's icon extraction fails on that and
     reports it as an AndroidManifest.xml parse error. A packaged vector fixes it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#C97B5A"
        android:pathData="M0,0h108v108h-108z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,30 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0z M30,74 a24,20 0 0,1 48,0z" />
</vector>
