{
  "name": "mytribe-functions",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p ../scripts/tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "build:watch": "tsc -w",
    "lint": "eslint src test scripts",
    "format": "prettier -w \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:ci": "vitest run --config vitest.ci.config.ts",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project mytribe-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "../../scripts/safe-deploy.sh mytribe -- firebase deploy --only functions:mytribe",
    "logs": "firebase functions:log",
    "contracts:generate": "ts-node --project scripts/tsconfig.json scripts/generateContracts.ts",
    "contracts:check": "ts-node --project scripts/tsconfig.json scripts/generateContracts.ts --check",
    "seeds:generate": "ts-node --project scripts/tsconfig.json scripts/generateSeedCorpus.ts",
    "seeds:check": "ts-node --project scripts/tsconfig.json scripts/generateSeedCorpus.ts --check",
    "runtime-options:expected": "ts-node --project scripts/tsconfig.json scripts/runtimeOptions/cli.ts",
    "runtime-options:diff": "ts-node --project scripts/tsconfig.json scripts/runtimeOptions/cli.ts --deployed",
    "runtime-options:cli": "ts-node --project scripts/tsconfig.json scripts/runtimeOptions/cli.ts",
    "backfill:invoice-state": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/backfillInvoiceStateStamp.ts",
    "backfill:invoice-date": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/backfillInvoiceDateIso.ts",
    "backfill:household-vet": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/backfillKinfolkVetToHousehold.ts",
    "strip:visit-location": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/stripBookingVisitLocation.ts",
    "sweep:kinfolk-staff-notes": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/sweepKinfolkNotificationStaffNotes.ts",
    "backfill:booking-kin-roster": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/backfillBookingKinRoster.ts",
    "backfill:kintale-provenance": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/backfillKinTaleCreatedAtProvenance.ts",
    "backfill:tribal-intel-ids": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/backfillTribalIntelTargetIds.ts",
    "backfill:notif-split": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/backfillNotificationDeliverySplit.ts",
    "backfill:broadcast-category": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/backfillBroadcastNotificationCategory.ts",
    "backfill:stripe-payment-cents": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/backfillStripePaymentAmountCents.ts",
    "repair:blocked-slots": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/repairBlockedTimeSlotShape.ts",
    "repair:business-timezone": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/repairBusinessTimeZone.ts",
    "check:voice-secrets": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/checkVoiceSecrets.ts",
    "seed:emails": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/seedEmailTemplates.ts",
    "seed:notif-templates": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/seedNotificationTemplates.ts",
    "seed:demo-kinfolk": "NODE_PATH=node_modules ts-node --compiler \"$PWD/node_modules/typescript\" --project ../scripts/tsconfig.json ../scripts/seedDemoKinfolk.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@google-cloud/recaptcha-enterprise": "^7.1.0",
    "@googleapis/calendar": "^16.0.0",
    "@sentry/node": "^10.73.0",
    "argon2": "^0.45.1",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "handlebars": "^4.7.8",
    "libphonenumber-js": "^1.13.12",
    "pdf-lib": "^1.17.1",
    "sanitize-html": "^2.17.7",
    "stripe": "^22.6.1",
    "twilio": "^6.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.5.0",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase": "^12.18.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
