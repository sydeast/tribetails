{
  "name": "mytribe-functions",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "build:watch": "tsc -w",
    "lint": "eslint src test scripts",
    "format": "prettier -w \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:ci": "vitest run --config vitest.ci.config.ts",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project mytribe-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "../../scripts/safe-deploy.sh mytribe -- firebase deploy --only functions:mytribe",
    "logs": "firebase functions:log",
    "contracts:generate": "ts-node --project scripts/tsconfig.json scripts/generateContracts.ts",
    "contracts:check": "ts-node --project scripts/tsconfig.json scripts/generateContracts.ts --check",
    "backfill:invoice-state": "NODE_PATH=node_modules ts-node --project ../scripts/tsconfig.json ../scripts/backfillInvoiceStateStamp.ts",
    "seed:emails": "ts-node --project ../scripts/tsconfig.json ../scripts/seedEmailTemplates.ts",
    "seed:notif-templates": "ts-node --project ../scripts/tsconfig.json ../scripts/seedNotificationTemplates.ts",
    "seed:demo-kinfolk": "ts-node --project ../scripts/tsconfig.json ../scripts/seedDemoKinfolk.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google-cloud/recaptcha-enterprise": "^6.4.2",
    "@sentry/node": "^10.68.0",
    "argon2": "^0.45.1",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.0",
    "googleapis": "^173.0.0",
    "handlebars": "^4.7.8",
    "libphonenumber-js": "^1.13.9",
    "pdf-lib": "^1.17.1",
    "sanitize-html": "^2.17.6",
    "stripe": "^22.3.2",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^26.1.2",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase": "^12.16.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
