# Firebase project: auntieos-ttpc (single project)
# Functions runtime — set via firebase functions:secrets:set in production

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
SENTRY_DASHBOARD_URL=https://auntieos-ttpc.sentry.io

SENDGRID_API_KEY=
SENDGRID_FROM=auntie@tribetails.com

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary — signed uploads for kinfolk avatar + kin photos (signKinfolkAvatar /
# uploadKinPhoto). Without these, signing throws failed-precondition and the
# client shows "Cloudinary not configured". Set via:
#   firebase functions:secrets:set CLOUDINARY_CLOUD_NAME
#   firebase functions:secrets:set CLOUDINARY_API_KEY
#   firebase functions:secrets:set CLOUDINARY_API_SECRET
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AUNTIE_OPERATOR_UIDS=
AUNTIE_NOTIFY_EMAIL=auntie@tribetails.com

SHARE_LINK_BASE_URL=https://kinfolk.tribetails.com/share
CLAIM_LINK_BASE_URL=https://kinfolk.tribetails.com/claim
AUNTIE_OS_REVIEW_BASE_URL=

# BigQuery — project auntieos-ttpc, region us-south1, dataset to be created
BIGQUERY_PROJECT=auntieos-ttpc
BIGQUERY_REGION=us-south1
BIGQUERY_AUDIT_DATASET=mytribe_audit

# Argon2 pepper for tribePin hashing — generate with: openssl rand -hex 32
TRIBE_PIN_PEPPER=

# (Firebase Auth providers configured in console — no env vars required for backend)
