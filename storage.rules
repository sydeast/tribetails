rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isAuntie() { return signedIn() && request.auth.token.admin == true; }
    function isKinfolk() {
      return signedIn() && request.auth.token.role == 'kinfolk' && request.auth.token.kinfolkId != null;
    }

    function ownsKinfolk(kid) {
      return isKinfolk() && request.auth.token.kinfolkId == kid;
    }

    // KinTale media — written by AuntieOS (admin), read by family members.
    // Layout: families/{kinfolkId}/kinTales/{taleId}/{mediaId}
    match /families/{kinfolkId}/kinTales/{taleId}/{mediaId} {
      allow read: if isAuntie() || ownsKinfolk(kinfolkId);
      allow write: if isAuntie();
    }

    // Kin photos — uploaded from MyTribe portal, read by family + Auntie.
    // Layout: families/{kinfolkId}/kin/{kinId}/{filename}
    match /families/{kinfolkId}/kin/{kinId}/{filename} {
      allow read: if isAuntie() || ownsKinfolk(kinfolkId);
      allow create, update: if isAuntie() || ownsKinfolk(kinfolkId);
      allow delete: if isAuntie() || ownsKinfolk(kinfolkId);
    }

    // Family avatar / cover image — primary contact only.
    match /families/{kinfolkId}/profile/{filename} {
      allow read: if isAuntie() || ownsKinfolk(kinfolkId);
      allow write: if isAuntie() || ownsKinfolk(kinfolkId);
    }

    // Anything else — denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
