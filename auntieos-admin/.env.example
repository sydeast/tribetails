# Baserow connection
BASEROW_URL=http://localhost:51001
BASEROW_TOKEN=your_database_token_here

# User credentials (used to refresh JWT when refresh token expires too)
BASEROW_EMAIL=tribetails@tribetails.com
BASEROW_PASSWORD=

# Cached JWTs (auto-managed by baserow_auth.py; leave blank to force fresh login)
BASEROW_JWT=
BASEROW_REFRESH=

# Table IDs for reference
BASEROW_DATABASE_ID=201
BASEROW_TABLE_KINFOLK=622
BASEROW_TABLE_KIN=629
BASEROW_TABLE_VISIT_LOGS=630
BASEROW_TABLE_STAGING=621
BASEROW_TABLE_GENERATED_DRAFTS=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Server
AUNTIE_SERVER_HOST=0.0.0.0
AUNTIE_SERVER_PORT=51003
AUNTIE_SHARED_SECRET=

# --- Web admin (Vite / React) ---
# Sentry crash reporting for the React admin at auntie.tribetails.com. OPTIONAL:
# leave empty and reporting stays disabled (the app logs
# "Sentry disabled: no VITE_SENTRY_DSN" and runs normally). To activate, paste
# the client DSN from the Sentry project (Settings > Client Keys / DSN) at
# https://auntieos-ttpc.sentry.io. The VITE_ prefix is REQUIRED for the value to
# reach the browser bundle. This is a public client key, not a server secret.
VITE_SENTRY_DSN=
