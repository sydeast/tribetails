#!/usr/bin/env bash
# AuntieOS pre-commit gate.
#
# WHY A HOOK AND NOT GITHUB ACTIONS
# This repo is local-only (no remote, owner ruling: hosting comes after key
# rotation). A .github/workflows file would never run. MyTribe already has that
# exact dead file: functions-ci.yml exists, MyTribe/.git does not, so it has
# never executed once. A hook is the only gate that actually fires here.
#
# Enabled by:  git config core.hooksPath .githooks
# Bypass once: git commit --no-verify   (say why in the commit message)
#
# Fast by design (~1s). Gradle suites are too slow for a commit gate; run them
# before pushing work you care about.

set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1
FAIL=0

red()  { printf '\033[31m%s\033[0m\n' "$1"; }
grn()  { printf '\033[32m%s\033[0m\n' "$1"; }

staged() { git diff --cached --name-only --diff-filter=ACM; }

# ---------------------------------------------------------------------------
# 1. Secrets, by CONTENT not filename.
# ---------------------------------------------------------------------------
# Filename patterns are NOT sufficient in this tree. Proven 2026-07-15:
# "android/Scratch Folder/fcmChannelFirebase.json" is a real service_account
# private key for auntieos-ttpc and matches none of *serviceAccount*,
# *service-account*, *adminsdk*. It was caught only by scanning content.
# Match real key MATERIAL, not documentation. A real service-account JSON has a
# "private_key": "-----BEGIN..." field; prose that merely mentions the phrase
# "type: service_account" or "BEGIN PRIVATE KEY" (e.g. this .gitignore's own
# detection comment, or a code-review write-up) does not. Requiring the quoted
# private_key value or a full key token avoids those false positives.
# sk_live_ (Stripe) folded in from the admin repo's hook during the 07-21 merge.
#
# `sk\.eyJ` (Mapbox SECRET token) added 2026-07-21 after a real one was found
# committed in android/gradle.properties.example. A file called ".example" is
# exactly where this hides: it reads as a template, so nobody looks twice, and
# the previous pattern list did not cover Mapbox's format. Public `pk.` tokens
# are NOT matched on purpose, they are designed to ship in clients.
SECRET_RE='"private_key"[[:space:]]*:[[:space:]]*"-----BEGIN|-----BEGIN [A-Z ]*PRIVATE KEY-----[A-Za-z0-9+/=]|sk-ant-[A-Za-z0-9_-]{40,}|SG\.[A-Za-z0-9_-]{30,}|sk_live_[A-Za-z0-9]{10,}|sk\.eyJ[A-Za-z0-9._-]{20,}'

HITS=""
while IFS= read -r f; do
  [ -f "$f" ] || continue
  # This hook's own source contains the detection patterns; scanning it would
  # always self-match. Skip it (and the .gitignore, whose comment documents the
  # content-scan command).
  case "$f" in .githooks/pre-commit|.gitignore) continue ;; esac
  if grep -qIE "$SECRET_RE" "$f" 2>/dev/null; then
    HITS="$HITS  $f"$'\n'
  fi
done < <(staged)

if [ -n "$HITS" ]; then
  red "BLOCKED: staged file(s) contain what looks like a live credential:"
  printf '%s' "$HITS"
  echo "  A service-account key, private key block, or an Anthropic, SendGrid,"
  echo "  Stripe live, or Mapbox SECRET (sk.) token."
  echo "  Add the path to .gitignore. Do NOT commit and clean up later:"
  echo "  once it is in history, the key must be ROTATED, not just removed."
  FAIL=1
else
  grn "ok: no credentials in staged content"
fi

# ---------------------------------------------------------------------------
# 2. firestore.rules mirror must match MyTribe (the source of truth).
# ---------------------------------------------------------------------------
# Both trees declare firestore.rules on the SAME project (auntieos-ttpc), so a
# deploy from either overwrites live rules. This mirror drifted 06-22 -> 07-13
# and would have reverted the portal's scoped kinfolk read.
MYTRIBE_ROOT="${MYTRIBE_ROOT:-/Users/sydeast/Projects/testai/CascadeProjects/MyTribe}"
SRC="$MYTRIBE_ROOT/firestore.rules"
MIRROR="web/firestore.rules"

if staged | grep -qx "$MIRROR"; then
  if [ ! -f "$SRC" ]; then
    red "WARN: MyTribe tree not found at $SRC"
    echo "  Rules-drift is UNCHECKED for this commit. Set MYTRIBE_ROOT to enable."
  elif ! diff -q "$MIRROR" "$SRC" >/dev/null 2>&1; then
    red "BLOCKED: $MIRROR has DRIFTED from the source of truth."
    echo "  Edit MyTribe/firestore.rules, then: cp $SRC $MIRROR"
    FAIL=1
  else
    grn "ok: firestore.rules mirror matches MyTribe"
  fi
fi

# ---------------------------------------------------------------------------
# 3. web/functions unit tests, when that code is touched.
# ---------------------------------------------------------------------------
if staged | grep -q '^web/functions/'; then
  if (cd web/functions && npm test >/dev/null 2>&1); then
    grn "ok: web/functions tests pass"
  else
    red "BLOCKED: web/functions tests FAIL."
    echo "  Run: cd web/functions && npm test"
    FAIL=1
  fi
fi

[ "$FAIL" -eq 0 ] || { echo; red "pre-commit FAILED. Fix the above, or --no-verify with a reason."; exit 1; }
exit 0
