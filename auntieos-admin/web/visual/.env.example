# Copy to .env and fill. .env is gitignored. No fabricated creds (project fail-loud policy).
#
# THIS FILE IS FOR THE COMPOSE WASM ADMIN, not the React one. These captures drive
# a Skia canvas through window.__fb. The React admin at auntie.tribetails.com has
# no such bridge; its browser coverage lives in auntieos-admin/e2e/ and needs no
# credentials, because it runs against the Firebase emulator.
VISUAL_ADMIN_EMAIL=
VISUAL_ADMIN_PASSWORD=
# Optional overrides:
# Defaults to https://auntieos-admin.web.app, the site web/firebase.json deploys
# the wasm build to. Do NOT point this at auntie.tribetails.com: that host has
# served the React admin since 2026-07-20 and every screen will fail.
# VISUAL_BASE_URL=http://localhost:8080            # e.g. a local `npm run serve-dist`
# VISUAL_DEMO_INVOICE_ID=                          # a _demo:true invoice doc id for the invoice-detail route
# VISUAL_DEMO_REPORT_ID=                            # a _demo:true session id for the kintale-report route
# VISUAL_DEMO_SCHEMA_ID=                            # a _demo:true formSchema doc id for the formschema-editor route (getFormSchema callable)
