# Service-account private keys. TWO real live keys exist for
# auntieos-ttpc.iam.gserviceaccount.com, found by CONTENT not filename:
#   android/serviceAccount.json
#   android/Scratch Folder/fcmChannelFirebase.json   <- name matches no pattern
# Filename patterns are not sufficient here. Before any commit that adds .json,
# re-scan content:
#   find . -name '*.json' -not -path '*/node_modules/*' -not -path '*/build/*' \
#     -not -path './.git/*' -exec grep -l '"type": "service_account"' {} +
android/serviceAccount.json
android/Scratch Folder/
android/app/src/main/service-account-key.json
android/app/src/main/assets/service-account-key.json
*serviceAccount*.json
*service-account*.json
