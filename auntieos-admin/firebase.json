{
  "hosting": {
    "target": "app",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/cloudinary/sign-upload",
        "function": "signCloudinaryUpload"
      },
      {
        "source": "/api/generate",
        "function": "generateAuntieCopy"
      },
      {
        "source": "/api/send-message",
        "function": "sendMessage"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
