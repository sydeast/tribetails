{
  "name": "auntieos-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:record": "VITE_ISSUE_RECORDER=1 vite",
    "prebuild": "npm --prefix ../packages/issue-recorder run build:bookmarklet && mkdir -p public && cp ../packages/issue-recorder/dist/__recorder.js public/__recorder.js",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run e2e:tsc && npm run e2e:coverage && firebase emulators:exec --project auntieos-ttpc --only auth,firestore --config e2e.firebase.json \"npx playwright test --config e2e/playwright.config.ts\"",
    "e2e:tsc": "tsc -p e2e",
    "e2e:coverage": "node e2e/spec-coverage.mjs",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "@sentry/react": "^10.70.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "@tribetails/geo": "*",
    "firebase": "^12.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "@tribetails/issue-recorder": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
