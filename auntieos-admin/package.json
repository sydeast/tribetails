{
  "name": "auntieos-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run e2e:tsc && firebase emulators:exec --project auntieos-ttpc --only auth,firestore --config e2e.firebase.json \"npx playwright test --config e2e/playwright.config.ts\"",
    "e2e:tsc": "tsc -p e2e",
    "e2e:install": "playwright install --with-deps chromium",
    "visual:react": "npm run e2e:tsc && VISUAL_CAPTURE=1 firebase emulators:exec --project auntieos-ttpc --only auth,firestore --config e2e.firebase.json \"npx playwright test --config e2e/playwright.config.ts --project visual\"",
    "visual:react:verify": "node web/visual/baseline.mjs verify react"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "@sentry/react": "^10.68.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.95.0",
    "firebase": "^12.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
