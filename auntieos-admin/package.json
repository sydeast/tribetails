{
  "name": "auntieos-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:record": "VITE_ISSUE_RECORDER=1 vite",
    "prebuild": "npm --prefix ../packages/issue-recorder run build:bookmarklet && mkdir -p public && cp ../packages/issue-recorder/dist/__recorder.js public/__recorder.js",
    "build": "tsc --noEmit && tsc -p tsconfig.sw.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run e2e:tsc && npm run e2e:coverage && firebase emulators:exec --project auntieos-ttpc --only auth,firestore --config e2e.firebase.json \"npx playwright test --config e2e/playwright.config.ts\"",
    "e2e:tsc": "tsc -p e2e",
    "e2e:coverage": "node e2e/spec-coverage.mjs",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:cy": "npm run e2e:cy:tsc && firebase emulators:exec --project auntieos-ttpc --only auth,firestore --config e2e.firebase.json \"npm run e2e:cy:run\"",
    "e2e:cy:tsc": "tsc -p cypress",
    "e2e:cy:run": "start-server-and-test e2e:cy:server http://127.0.0.1:5174 \"cypress run\"",
    "e2e:cy:open": "npm run e2e:cy:tsc && firebase emulators:exec --project auntieos-ttpc --only auth,firestore --config e2e.firebase.json \"start-server-and-test e2e:cy:server http://127.0.0.1:5174 'cypress open --e2e --browser electron'\"",
    "e2e:cy:server": "VITE_E2E_EMULATOR=127.0.0.1 vite --port 5174 --strictPort --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "@sentry/react": "^10.73.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@tribetails/geo": "*",
    "firebase": "^12.18.0",
    "mapbox-gl": "^3.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4",
    "@tribetails/issue-recorder": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^16.0.0",
    "jsdom": "^30.0.0",
    "start-server-and-test": "^3.0.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
